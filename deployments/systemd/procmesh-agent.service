[Unit]
Description=ProcMesh Agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/lib/procmesh/current/procmesh-agent --data-dir /var/lib/procmesh --listen 127.0.0.1:18680 --shim-bin /usr/local/lib/procmesh/current/procmesh-shim
Restart=on-failure
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
