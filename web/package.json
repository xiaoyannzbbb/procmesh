{
  "name": "procmesh-web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run i18n:types",
    "dev": "vite",
    "build": "vite build",
    "prebuild:check": "npm run i18n:types",
    "build:check": "vue-tsc -b && vite build",
    "pretest": "npm run i18n:types",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .vue,.ts,.tsx",
    "lint:fix": "eslint src --ext .vue,.ts,.tsx --fix",
    "analyze": "npm run build && node scripts/analyze-bundle.js",
    "i18n:types": "tsx scripts/generate-i18n-types.ts",
    "i18n:check": "node scripts/check-i18n-completeness.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@connectrpc/connect": "^2.0.2",
    "@connectrpc/connect-web": "^2.0.2",
    "@tanstack/vue-query": "^5.67.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-vue": "^5.0.0",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.4"
  }
}
